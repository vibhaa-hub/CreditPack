# copy to .env

# ---- Model provider (pick one) ----
# Gemini via AI Studio key:
GOOGLE_API_KEY=your-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
CPA_MODEL=gemini-2.5-flash

# Mistral (routed through LiteLLM): set the key and a model prefixed with "mistral/"
# MISTRAL_API_KEY=your-mistral-key
# CPA_MODEL=mistral/mistral-large-latest

# ---- Storage (case store, audit trail and ADK sessions) ----
# Default when unset: SQLite file at cpa_agents/.adk/cpa.db
# DATABASE_URL=sqlite:///cpa_agents/.adk/cpa.db
# Postgres 15+ (target):
# DATABASE_URL=postgresql://cpa_app:password@localhost:5432/cpa

# ---- Workbench (python -m workbench) ----
# Signs the sign-in cookie. Set it so sessions survive a restart; any long random string.
# CPA_WORKBENCH_SECRET=change-me-to-a-long-random-string
